# Example: a training repo whose relay is a GPU server.
RELAY_HOST=gpu-box
RELAY_REPO=projects/model
RELAY_BRANCH=main
RELAY_PUSH_REMOTE=origin
NAMESPACE=sync

# The network definition and the shipped checkpoint must always match.
REQUIRE_TOGETHER=("src/model -> release/model.pt")
# A new checkpoint should come with its own config.
WARN_TOGETHER=("release/model.pt -> release/config.yaml")
# Only run the (slow) evaluation when something it depends on changed.
VERIFY_PATHS=(release src/model)
