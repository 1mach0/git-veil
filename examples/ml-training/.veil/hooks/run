# `git veil stage NAME --run --env "LR=3e-4" -- --seed 7`
# Background the job so the ssh session returns; logs stay in the worktree.
mkdir -p logs
nohup python scripts/train.py --run-name "$VEIL_NAME" "$@" > "logs/$VEIL_NAME.out" 2>&1 &
echo "started $VEIL_NAME (pid $!), log: $VEIL_WORKTREE/logs/$VEIL_NAME.out"
